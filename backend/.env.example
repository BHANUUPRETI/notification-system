# Copy to .env  (NEVER commit the real .env)

# ---------------- Django core ----------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma separated. Use * only for local dev.
# CORS_ORIGINS=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Use "postgres" in production (Render), leave empty for local sqlite.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# ---------------- Sandbox mode ----------------
# When true, nothing leaves the machine: messages are logged + stored only.
# Turn this OFF once real sandbox keys are in place.
NOTIFICATION_SANDBOX=True

# ---------------- WhatsApp Cloud API (Meta sandbox) ----------------
# https://developers.facebook.com -> My Apps -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Test recipients allowed to receive sandbox messages (comma separated E.164)
WHATSAPP_TEST_RECIPIENTS=

# ---------------- Email ----------------
# EMAIL_PROVIDER: postmark | brevo | resend | mailgun | ses | console
EMAIL_PROVIDER=postmark
DEFAULT_FROM_NAME=Notify Demo
DEFAULT_REPLY_TO=noreply@example.com

# Postmark (postmarkapp.com -> developer server token)
POSTMARKAPP_TOKEN=
POSTMARK_FROM_EMAIL=

# Brevo (300 emails/day free)
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# Resend (3,000 emails/month free)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=

# Amazon SES
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
AWS_REGION=us-east-1

# ---------------- Web Push ----------------
# Option A: OneSignal Web Push (simplest, free)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Option B: raw Web Push via VAPID keys (used by the pywebpush provider)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:you@example.com

# ---------------- Public (exposed to frontend via /api/config/) ----------------
FRONTEND_URL=http://localhost:3000

# ---------------- Internal scheduler ----------------
# Shared secret for POST /api/internal/scan-inactive/ (used instead of a cron
# job, because Render's free plan cannot run cron). Leave blank to disable.
SCAN_TOKEN=
